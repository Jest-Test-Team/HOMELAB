# Copy to /etc/homelab/deploy.env (root:root 0644). Non-secret settings only.
REPO_DIR=/opt/homelab/repo
RELEASES_DIR=/opt/homelab/releases
STATE_DIR=/opt/homelab/state
BACKUP_DIR=/mnt/offdevice-backup/homelab    # NOT on the VM's own HDD
ALLOWED_REMOTE=git@github-homelab:Jest-Test-Team/HOMELAB.git
DEPLOY_BRANCH=main
REGISTRY=ghcr.io
REGISTRY_OWNER=jest-test-team                 # lowercase GitHub owner
GHCR_CREDENTIALS=/home/<vm-user>/.config/homelab/ghcr.env  # private packages only; 0600, user-owned
KUBECTL=kubectl                               # uses ~/.kube/config (0600, see runbook)
NAMESPACE=homelab
MIN_FREE_GIB=5
ROLLOUT_TIMEOUT=180s
