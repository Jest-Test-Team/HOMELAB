# Keys only. Real values live in /etc/homelab/secrets/*.env on the VM (mode 0600)
# and reach pods as Kubernetes Secrets. Never commit a filled-in copy.

# --- homelab-app secret (api, worker, migrate job) ---
DATABASE_URL=postgres://homelab:CHANGE_ME@postgres.homelab.svc:5432/homelab
REDIS_URL=redis://:CHANGE_ME@redis.homelab.svc:6379/0

# --- homelab-postgres secret ---
POSTGRES_USER=homelab
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=homelab

# --- homelab-redis secret ---
REDIS_PASSWORD=CHANGE_ME

# --- homelab-mcp secret ---
MCP_AUTH_TOKEN=CHANGE_ME_LONG_RANDOM

# --- non-secret settings (set in manifests) ---
RUST_LOG=info
BIND_ADDR=0.0.0.0:8080
GIT_SHA=unknown
