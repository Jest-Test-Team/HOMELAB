/.claude
/target/

# Secrets and credentials must never be committed.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ecdsa*
*_ed25519
id_ed25519*
k3s.yaml
kubeconfig*
*.agekey
age.key
secrets/

# Private evidence (unredacted output) stays local.
docs/evidence/private/

# Generated per deploy by deploy-from-github.sh.
deploy/k8s/release/
/docs/evidence
env.local

# Frontend build output (built in Docker/CI, never committed).
frontend/node_modules/
frontend/.next/
frontend/out/

# Terraform local state / plugins.
lab/terraform/.terraform/
lab/terraform/.terraform.lock.hcl
*.tfstate
*.tfstate.*

# Python bytecode
__pycache__/
*.pyc
