/.claude
/target/

# Secrets and credentials must never be committed.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ecdsa*
*_ed25519
id_ed25519*
k3s.yaml
kubeconfig*
*.agekey
age.key
secrets/
# age private identities (public recipients lab/crypto/*.recipient and
# recipients.txt ARE committed; only the secret identity must never be).
*.identity
lab-identity.txt
# plaintext/encrypted evidence bundles are built on the fly, never committed
# to main (the encrypted blob is force-pushed to the orphan evidence-inbox branch).
*.tar.zst
*.tar.zst.age
*.tar.zst.enc
lab/analysis/out/

# Private evidence (unredacted output) stays local.
docs/evidence/private/

# Generated per deploy by deploy-from-github.sh.
deploy/k8s/release/
/docs/evidence
env.local

# Frontend build output (built in Docker/CI, never committed).
frontend/node_modules/
frontend/.next/
frontend/out/

# Terraform local state / plugins.
lab/terraform/.terraform/
lab/terraform/.terraform.lock.hcl
*.tfstate
*.tfstate.*

# Python bytecode
__pycache__/
*.pyc
lab/scripts/enter_vms.sh
local.env
