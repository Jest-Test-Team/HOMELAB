# syntax=docker/dockerfile:1.10
# dashboard: linux/arm64. Multi-stage:
#   1) node builds the Next.js static export (frontend/out)
#   2) rust builds the `dashboard` binary (native arm64, no cross-compilation)
#   3) distroless runtime serves the binary + the exported assets
# Base images are pinned by digest; bump tag and digest together.

FROM node:22.20.0-trixie-slim@sha256:f3bca16c4b87ad0c7abfad97f6803898ee9b08a1f153a269140f0a08f50231d2 AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,id=npm-cache,target=/root/.npm \
    npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build   # emits ./out (output: "export")

FROM rust:1.99.0-slim-trixie@sha256:2752b332db73fdbb7dc576f06c82ed1f312005784ef913d7e04a28f5f55dc581 AS build
ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA} \
    RUSTUP_TOOLCHAIN=1.99.0 \
    CARGO_TERM_COLOR=never
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates crates
COPY migrations migrations
RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-target-dashboard,target=/src/target \
    cargo build --locked --release -p homelab-dashboard --bin dashboard \
 && install -D -m 0755 target/release/dashboard /out/dashboard

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:83b9b50586253821cf63ffcec87d3d94265a093ad30da232039af962dd8f4edf
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.title="homelab-dashboard"
COPY --from=build /out/dashboard /usr/local/bin/dashboard
COPY --from=web /web/out /usr/local/share/dashboard
ENV STATIC_DIR=/usr/local/share/dashboard
USER 65532:65532
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/dashboard"]
